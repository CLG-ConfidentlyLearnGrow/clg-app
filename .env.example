# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this in the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# Billing (all optional until billing is switched on). Use Stripe TEST keys
# (sk_test_...) until CLG is ready; a live key is refused unless
# BILLING_LIVE_PAYMENTS=on.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
BILLING_LIVE_PAYMENTS=off
# Xero app from developer.xero.com (Starter tier is free).
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=
# Account codes in CLG's Xero chart of accounts.
XERO_SALES_ACCOUNT=200
XERO_STRIPE_CLEARING_ACCOUNT=
# 32 random bytes, base64 (for example: openssl rand -base64 32).
BILLING_ENCRYPTION_KEY=
# Any long random text; Vercel sends it with the daily billing run.
CRON_SECRET=

# Teams links (optional until set up). From the app registered in Microsoft
# Entra (portal.azure.com > App registrations): Directory (tenant) ID,
# Application (client) ID, and a client secret.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Emails (optional until set up). From resend.com > API Keys. The same key
# is the SMTP password in Supabase > Authentication > Emails > SMTP Settings.
RESEND_API_KEY=
EMAIL_FROM=CLG Tutoring <noreply@clgtutoring.com>
# Where replies go, for example CLG's main inbox.
EMAIL_REPLY_TO=
